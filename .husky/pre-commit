#!/bin/sh
# Keeps this fast and non-blocking for backend-only changes: frontend lint/format only runs
# when frontend/ or admin-portal/ files are staged; backend compile check only runs when
# backend/ files are staged. Full test suites stay in CI (see .github/workflows/ci.yml) rather
# than here, since a pre-commit hook that takes minutes gets bypassed with --no-verify in practice.
#
# Every checker below is invoked as `python3`, never `python`. This is not style. macOS removed the
# bare `python` command in 12.3 and Ubuntu has not shipped it since 20.04, so on a current machine
# `python` is simply absent -- and because each call is `|| exit 1`, the first one turns into
# "python: command not found" and blocks EVERY commit, including the ones the guards would have
# passed. The failure arrives the moment someone runs `npm install` at the repo root to install
# these hooks, which makes it look like installing the hooks broke the repository.
#
# .github/workflows/ci.yml calls the same scripts the same way, for the same reason.

staged=$(git diff --cached --name-only)

# The exit code must be honoured. This was previously called bare, so the script could print
# "COMMIT BLOCKED: real customer data must never enter this repository", exit 1, and the commit
# would proceed anyway -- the hook simply carried on to the next statement and exited 0. A guard
# that announces a block it does not enforce is worse than no guard: it reads as protection in
# review while letting exactly what it warns about through.
sh scripts/check-fixture-hygiene.sh || exit 1

# Best-effort local secret scan: only when the `gitleaks` binary is present. It is a single Go
# binary (brew install gitleaks, or see https://github.com/gitleaks/gitleaks#installing), not
# something `npm install` at the repo root provisions the way it does for husky itself, so a fresh
# clone without it must not be blocked. The actual gate is the "Secret scan" job in
# .github/workflows/ci.yml, which always has the binary via gitleaks/gitleaks-action -- this is
# the fast local nicety that catches a secret before it is ever pushed, not the enforcement point.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --no-banner --redact || exit 1
else
  echo "note: gitleaks not installed locally, skipping local secret scan (CI still runs it) -- see https://github.com/gitleaks/gitleaks#installing" >&2
fi

# Always, and cheap (one `git ls-files -s`): a mode regression is not tied to which files are
# staged, and this one cost the backend job every CI run it ever had. Catching it here matters
# more than the CI copy, because core.fileMode is false on Windows -- the bit cannot be restored
# by chmod, so a developer who "fixes" it locally and commits changes nothing at all.
python3 scripts/check-executable-bits.py || exit 1

# Only when an API client is actually being touched -- this is the exact moment drift happens: one
# client gets fixed and the other two don't. That is how a 401-handling fix landed on web, missed
# mobile, and shipped a bug where a mistyped password revoked every session on every device. See
# the script's docstring, which also records why this is a check rather than a shared module.
if echo "$staged" | grep -qE '^(frontend|admin-portal|mobile)/src/api/client\.ts$'; then
  python3 scripts/check-client-auth-policy.py || exit 1
fi

# Any staged app source can introduce a hardcoded mailbox, so this keys off src/ broadly rather
# than a named file. Catching it here matters more than the CI copy does: the failure mode is a
# dead mailto on a live marketing page, and the address is easiest to fix while it is still being
# typed. Runs whole-repo, so it also catches a copy staged in a different app than this one.
if echo "$staged" | grep -qE '^(frontend|admin-portal|mobile)/src/'; then
  python3 scripts/check-contact-addresses.py || exit 1
  # Same trigger, same reason: a dashboard label that names the wrong month is easiest to fix while
  # it is still being typed, and this is exactly the kind of change that lands in one client only.
  python3 scripts/check-reporting-period-labels.py || exit 1
fi

# Keyed off both sides of the contract: renaming a meter in the framework breaks a dashboard just as
# surely as mistyping the query does, and the person renaming the meter is the one least likely to
# think about Grafana.
if echo "$staged" | grep -qE '^(ops/monitoring/|backend/src/main/java/com/finora/observability/)'; then
  python3 scripts/check-dashboard-metrics.py || exit 1
fi

if echo "$staged" | grep -qE '^(frontend|admin-portal|mobile)/'; then
  # ACMR only -- a deleted file has nothing for eslint --fix to fix, and re-adding a path that no
  # longer exists on disk fails with "pathspec did not match any files" and aborts the commit,
  # which previously happened to block every commit that deleted a frontend/admin-portal/mobile
  # file, not just ones that touched lint-relevant code.
  staged_existing=$(git diff --cached --name-only --diff-filter=ACMR)
  # Bug 48. Every one of the four spots below used to expand a multi-line file list as an unquoted
  # `$(...)` (or, for the git add below, an unquoted plain variable) argument list -- POSIX sh word-
  # splits that on $IFS, so a staged path containing a space (a real, staged filename is well within
  # scope here -- see this block's own comment above on why deleted files needed handling at all)
  # became two or more separate arguments: eslint --fix got handed nonexistent path fragments and
  # silently skipped both, or git add failed outright with "pathspec did not match any files".
  # Looping with `while IFS= read -r f` -- the same pattern scripts/check-fixture-hygiene.sh already
  # uses for exactly this reason -- preserves each filename whole.
  if echo "$staged_existing" | grep -q '^frontend/'; then
    (
      cd frontend || exit 0
      echo "$staged_existing" | grep '^frontend/' | sed 's#^frontend/##' | while IFS= read -r f; do
        npx eslint --fix -- "$f" 2>/dev/null || true
      done
    )
  fi
  if echo "$staged_existing" | grep -q '^admin-portal/'; then
    (
      cd admin-portal || exit 0
      echo "$staged_existing" | grep '^admin-portal/' | sed 's#^admin-portal/##' | while IFS= read -r f; do
        npx eslint --fix -- "$f" 2>/dev/null || true
      done
    )
  fi
  # mobile/eslint.config.js was added alongside the CI lint step (see ci.yml's mobile Lint step) --
  # this block was never updated to match, so a staged mobile/ file got none of the auto-fix
  # frontend and admin-portal already get, and reached CI as the first lint pass it ever saw.
  if echo "$staged_existing" | grep -q '^mobile/'; then
    (
      cd mobile || exit 0
      echo "$staged_existing" | grep '^mobile/' | sed 's#^mobile/##' | while IFS= read -r f; do
        npx eslint --fix -- "$f" 2>/dev/null || true
      done
    )
  fi
  existing_to_add=$(echo "$staged_existing" | grep -E '^(frontend|admin-portal|mobile)/')
  if [ -n "$existing_to_add" ]; then
    printf '%s\n' "$existing_to_add" | while IFS= read -r f; do
      git add -- "$f"
    done
  fi
fi

if echo "$staged" | grep -q '^backend/'; then
  # Before the compile, because it is ~0.4s against the compile's tens of seconds and it names
  # the file and the missing type directly. It was CI-only at first on the assumption it was too
  # slow for a hook -- it took 28s, until it was measured and found to be doing one regex search
  # per (file, type) pair rather than tokenising each file once.
  #
  # Whole-repo rather than staged-files-only, and deliberately: this catches the case where
  # MOVING type A breaks unrelated file B that relied on them sharing a package. B is not staged,
  # which is exactly why the bug survives review.
  python3 scripts/check-imports.py || exit 1

  (cd backend && ./mvnw -q -o compile) || {
    echo "Backend fails to compile — commit blocked. Run 'cd backend && ./mvnw compile' for details." >&2
    exit 1
  }
fi
