# Copy this file to .env (or .env.local) and fill in your own values. Vite only exposes
# variables prefixed VITE_ to client-side code -- see vite.config.ts / src/vite-env.d.ts.

# The backend's own absolute origin, e.g. https://api.finoratech.info -- REQUIRED
# for any real deployment (Cloudflare Workers, or anywhere else the built frontend and the
# backend don't share an origin). Leave unset for local dev: it then falls back to a same-origin
# relative path, which Vite's own dev-server proxy (vite.config.ts) forwards to
# http://localhost:8080 for you. See src/api/client.ts's own doc comment for the full story on
# why this matters -- a relative path silently does nothing useful once this is actually built
# and deployed as static files, since there's no dev server left to proxy anything.
VITE_API_BASE_URL=

# Publishable key from https://logo.dev (Dashboard -> API Keys). Used by BOTH BankLogo.tsx
# (bank logos, looked up by domain) and MerchantLogo.tsx (transaction merchant logos, looked up
# by name) -- one token, two callers, same as this app's other shared CDN credentials. This is a
# publishable key, not a secret API key, so it's safe to ship in built frontend code. Leave this
# unset to skip Logo.dev entirely: BankLogo then falls back to a locally dropped-in SVG (see
# src/assets/banks/README.md) then a colored-initials badge, and MerchantLogo falls straight to
# its own colored-initials badge -- exactly as BankLogo worked before any logo CDN was wired in.
#
# Attribution: Logo.dev's free tier requires a visible attribution link back to Logo.dev for
# commercial use (their docs -- not independently re-verified as of this comment, since the site
# was rate-limiting fetches when this was written; check https://www.logo.dev before relying on
# this). That link does not exist anywhere in this app yet -- add one, or move to a paid plan,
# before shipping this to production on the free tier.
VITE_LOGODEV_TOKEN=

# Firebase Web SDK config -- powers Firebase Phone Authentication (OTP send/confirm for
# registration, password reset, and authenticated password change; see src/lib/firebase.ts and
# src/lib/phoneAuth.ts). Get these six values from Firebase Console -> Project Settings ->
# General -> "Your apps" -> the SDK config snippet. Not secrets in the way a paid API key would
# be -- Firebase's own docs treat this as safe to ship client-side -- but still real per-project
# values, not placeholders. Leaving these unset doesn't break the rest of the app: Firebase init
# is lazy (getFirebaseAuth()), so only the phone-verification screens fail, and only once used.
#
# Locally these are your own choice, but for the deployed Dev tier (dev-app.finoratech.info) they
# belong to a SEPARATE Firebase project from production's, set in Cloudflare Pages' "Preview"
# environment-variable bucket (not "Production") -- see deployment-guide.md's "Dev environment"
# section for why Dev intentionally never shares production's Firebase project or Google accounts.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# "Sign in with Google" (D-23) -- Google's OAuth client ID for the web app, from Google Cloud
# Console -> APIs & Services -> Credentials -> an "OAuth 2.0 Client ID" of type "Web application".
# A public value (Google Identity Services is designed to run entirely client-side), safe to ship
# in the built bundle -- but a real per-project value, and deliberately a SEPARATE registration
# from whatever client id the backend's Gmail-sync integration uses (see GoogleLoginProperties'
# own doc comment on the backend for why). Leave unset to hide the Google button entirely on
# Register/Login (GoogleSignInButton.tsx) -- everything else keeps working exactly as before.
VITE_GOOGLE_LOGIN_CLIENT_ID=

# Sentry crash reporting. Leave empty to disable it entirely -- src/lib/monitoring.ts no-ops when
# this is unset, so local development and the test suite never emit events. A DSN is not a secret
# in the way an API key is (it only permits writing events, and ships inside every client bundle),
# but it is a real per-project value: get it from Sentry -> Project Settings -> Client Keys (DSN).
#
# What gets sent is deliberately far narrower than Sentry's defaults, because this app's URLs carry
# the ledger search term and password-reset tokens -- see
# src/lib/monitoring.ts for exactly what is stripped and why.
#
# BUILD-TIME, not runtime. Vite inlines this into the bundle when it builds, so it must be set as a
# build environment variable on Cloudflare Pages -- setting it after the fact does nothing. The
# upside of that inlining, measured: with this unset the whole Sentry SDK is tree-shaken out of the
# bundle (verified: zero occurrences of "sentry" in dist/), so crash reporting costs nothing at all
# until it is actually configured. With it set the bundle grows by ~30 kB gzipped.
VITE_SENTRY_DSN=
