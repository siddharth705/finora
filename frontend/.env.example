# Copy this file to .env (or .env.local) and fill in your own values. Vite only exposes
# variables prefixed VITE_ to client-side code -- see vite.config.ts / src/vite-env.d.ts.

# The backend's own absolute origin, e.g. https://confident-wonder.up.railway.app -- REQUIRED
# for any real deployment (Cloudflare Workers, or anywhere else the built frontend and the
# backend don't share an origin). Leave unset for local dev: it then falls back to a same-origin
# relative path, which Vite's own dev-server proxy (vite.config.ts) forwards to
# http://localhost:8080 for you. See src/api/client.ts's own doc comment for the full story on
# why this matters -- a relative path silently does nothing useful once this is actually built
# and deployed as static files, since there's no dev server left to proxy anything.
VITE_API_BASE_URL=

# Free client ID from https://developers.brandfetch.com/dashboard (Brandfetch's Logo API is
# free up to 500,000 requests/month, no attribution required -- see BankLogo.tsx). This is a
# client ID, not a secret API key, so it's safe to ship in built frontend code. Leave this unset
# to skip Brandfetch entirely: BankLogo then falls back to a locally dropped-in SVG (see
# src/assets/banks/README.md), then a colored-initials badge, exactly as it worked before
# Brandfetch was wired in.
VITE_BRANDFETCH_CLIENT_ID=

# Firebase Web SDK config -- powers Firebase Phone Authentication (OTP send/confirm for
# registration, password reset, and authenticated password change; see src/lib/firebase.ts and
# src/lib/phoneAuth.ts). Get these six values from Firebase Console -> Project Settings ->
# General -> "Your apps" -> the SDK config snippet. Not secrets in the way a paid API key would
# be -- Firebase's own docs treat this as safe to ship client-side -- but still real per-project
# values, not placeholders. Leaving these unset doesn't break the rest of the app: Firebase init
# is lazy (getFirebaseAuth()), so only the phone-verification screens fail, and only once used.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
