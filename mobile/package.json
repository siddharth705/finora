  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^26.1.0",
    "@react-native-firebase/auth": "^26.1.0",
    "@react-native-firebase/messaging": "26.3.2",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "axios": "^1.19.0",
    "expo": "~57.0.9",
    "expo-apple-authentication": "~57.0.1",
    "expo-build-properties": "~57.0.8",
    "expo-clipboard": "~57.0.1",
    "expo-crypto": "~57.0.2",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-local-authentication": "~57.0.2",
    "expo-print": "~57.0.1",
    "expo-screen-capture": "~57.0.2",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.8",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.8.1",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^26.1.2",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^57.0.5",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "eslint-plugin-react-native-a11y": "^3.5.1",
    "jest": "~29.7.0",
    "jest-expo": "57.0.4",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.2.8",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "_test_comment": "--experimental-vm-modules is required, not optional: client.ts reaches endpoints.ts through a dynamic import (they are mutually dependent, so a static one would be circular). Without the flag Node refuses that import inside Jest's VM, the refresh-on-401 branch throws before any network call, and every test touching it silently exercises the forced-sign-out path instead -- passing while asserting the opposite of what it claims. Metro implements import() itself, so this is a test-runner limitation rather than anything about the app.",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "expo lint --max-warnings 0",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/src/test/setup.ts"
    ],
    "testTimeout": 15000,
    "resolver": "react-native-worklets/jest/resolver",
    "moduleNameMapper": {
      "^react-native-reanimated$": "<rootDir>/node_modules/react-native-reanimated/src/index.ts",
      "^react-native-worklets$": "<rootDir>/node_modules/react-native-worklets/src/index.ts"
    }
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1",
    "decode-uri-component": "^0.5.0",
    "eslint-plugin-react-native-a11y": {
      "eslint": "$eslint"
    }
  },
  "allowScripts": {
    "@firebase/util@1.15.2": true,
    "@sentry/cli@2.58.4": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true,
    "unrs-resolver@1.12.2": true
  }
}
