# Copy this file to .env.local and fill in your own values. Expo only inlines variables prefixed
# EXPO_PUBLIC_ into the JS bundle (the same idea as Vite's VITE_ prefix in frontend/).

# The backend's own absolute origin, e.g. https://confident-wonder.up.railway.app -- REQUIRED,
# with no fallback. Unlike the web app (which can fall back to a same-origin relative path that
# Vite's dev-server proxy forwards), a native app has no dev server to proxy anything, so this
# must always be an absolute origin. src/api/client.ts throws at startup if it's unset.
#
# Either the bare origin or the origin with /api/v1 already appended works -- normalizeApiBase()
# in src/api/client.ts produces the same result either way.
EXPO_PUBLIC_API_BASE_URL=

# Sentry crash reporting. Leave empty to disable it entirely -- src/lib/monitoring.ts no-ops when
# this is unset, so local development and CI never emit events. A DSN is not a secret in the way an
# API key is (it only permits writing events, and ships inside every client bundle), but it is a
# real per-project value: get it from Sentry -> Project Settings -> Client Keys (DSN).
#
# Uploading source maps -- so a crash shows real file and line numbers instead of minified bundle
# offsets -- is separate, happens at build time, and needs SENTRY_ORG, SENTRY_PROJECT, and a
# SENTRY_AUTH_TOKEN available to the EAS build. That token IS a secret and must never be committed;
# store it as an EAS secret. See docs/engineering/mobile-setup.md.
EXPO_PUBLIC_SENTRY_DSN=

# NOTE: unlike frontend/.env.example, there are NO EXPO_PUBLIC_FIREBASE_* variables here.
# @react-native-firebase/auth reads its config from the native GoogleService-Info.plist (iOS) and
# google-services.json (Android) files instead -- download both from the Firebase Console (the
# same Firebase project the backend's GOOGLE_APPLICATION_CREDENTIALS service account belongs to)
# and place them in this directory. They're gitignored; see app.config.ts for where they're wired
# in. Without them, phone verification fails on device, mirroring the backend's own behavior when
# GOOGLE_APPLICATION_CREDENTIALS is unset.
