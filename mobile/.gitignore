# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase native config files -- real per-project credentials for the same Firebase project the
# backend authenticates against. Same rule as the backend's service-account JSON: never commit.
# Each developer downloads their own from the Firebase Console; see .env.example / app.config.ts.
GoogleService-Info.plist
google-services.json
# Same files for the dev Firebase project (APP_VARIANT=development). The rules above match exact
# names, so these need their own lines or a dev download lands in a commit.
GoogleService-Info.dev.plist
google-services.dev.json

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
