{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
    // "functions" alongside "src" so the Cloudflare Pages Functions are type-checked by the same
  // `tsc -b` the build runs. Cloudflare compiles them separately at deploy time, so without this
  // they are the one directory that can ship a type error to production with a green build -- and
  // functions/assets/ sits in front of every asset request.
  "include": ["src", "functions"]
}
