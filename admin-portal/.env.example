# Copy to .env.local (dev) or configure via your deploy pipeline's env injection for
# .env.production -- Vite picks up whichever applies automatically, no code changes needed.
#
# Used only by Diagnostics.tsx's "More detail" links (Swagger/Actuator) -- both live outside
# /api entirely on the backend, so they can't go through the dev-server's /api proxy the rest of
# this app relies on. Every other API call in this app uses relative /api paths and needs no
# configuration here; don't add more entries to this file just to "be consistent" unless
# something else genuinely can't use the proxy either.
#
# Defaults to http://localhost:8080 if unset (matches vite.config.ts's own proxy target).
VITE_BACKEND_ORIGIN=http://localhost:8080

# The backend's own absolute origin for the actual axios client (src/api/client.ts) -- REQUIRED
# for any real deployment where this app and the backend don't share an origin (see that file's
# own doc comment). Distinct from VITE_BACKEND_ORIGIN above, which only covers a couple of
# manually-built human-facing links, not the API client itself. Leave unset for local dev.
VITE_API_BASE_URL=

# Firebase Web SDK config -- same purpose and same values as frontend/.env.example's own copy of
# these six (this app's VerifyPhone.tsx/ResetPassword.tsx use Firebase Phone Authentication too;
# see src/lib/firebase.ts and src/lib/phoneAuth.ts). Get these from Firebase Console -> Project
# Settings -> General -> "Your apps" -> the SDK config snippet -- the same Firebase project as
# frontend/'s, and the same project the backend's GOOGLE_APPLICATION_CREDENTIALS service account
# belongs to.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
