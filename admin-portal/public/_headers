# Cloudflare Pages response headers. Vite copies public/ verbatim into dist/, so this ships with
# the build.
#
# ONLY the hashed-asset rule is here, deliberately. index.html is already served as
# "public, max-age=0, must-revalidate" by Pages' own defaults -- verified against production -- and
# that is exactly right: the HTML must be revalidated every load, because it is the file that names
# which chunk hashes are current. Restating it here would add a second place to get it wrong.
#
# Worth being clear about what this does and does not fix. It does NOT prevent the stale-chunk
# failure that motivated it. That failure happens to a tab which was ALREADY OPEN across a deploy:
# the module graph in memory holds the old hashes, and client-side navigation never re-fetches the
# HTML, so no cache header on any file can help. src/lib/staleChunk.ts is what handles that. This
# is a straightforward performance change that happens to live next door to it.

/*
  # Security headers for every response (production-readiness audit finding: this file only had
  # a caching rule, so the SPA shipped with none of Cloudflare Pages' security-header handling
  # doing anything meaningful -- Pages does not set a CSP or HSTS on your behalf).
  #
  # Mirrors the policy SecurityConfig.java sets for the API (default-src 'self'; frame-ancestors
  # 'none'; base-uri 'self'), widened only where this app genuinely needs it as a browser-rendered
  # SPA. Same reasoning as frontend/public/_headers (this app shares the same Firebase Phone Auth
  # flow, Google Fonts link, and Sentry monitoring setup -- see src/lib/phoneAuth.ts,
  # index.html, src/lib/monitoring.ts) except it has no Brandfetch usage, so img-src stays 'self'
  # data: with no third-party host added.
  #   - script-src adds https://www.gstatic.com and https://www.google.com -- Firebase Phone
  #     Auth's invisible reCAPTCHA Enterprise widget. Both are needed: gstatic.com serves
  #     supporting assets, but the loader script itself (recaptcha/enterprise.js) is served from
  #     google.com. Bug fix: missing google.com here silently broke OTP-sending (Firebase throws
  #     a generic auth/internal-error when the verifier's own script never loads) -- see
  #     frontend/public/_headers' own fix for the same gap, found via a real browser repro.
  #   - style-src adds https://fonts.googleapis.com and 'unsafe-inline' (style={{...}} usage).
  #   - font-src adds https://fonts.gstatic.com, where the Google Fonts stylesheet points its
  #     @font-face src at.
  #   - connect-src adds api.finoratech.info (VITE_API_BASE_URL -- see src/api/client.ts),
  #     identitytoolkit.googleapis.com and securetoken.googleapis.com (Firebase Auth's REST
  #     endpoints), and Sentry's ingest hosts (no-ops unless VITE_SENTRY_DSN is set).
  #   - frame-src allows https://www.google.com -- the reCAPTCHA challenge iframe.
  #   - frame-ancestors 'none' takes over X-Frame-Options' job (both do the same thing; setting
  #     both would just be two places to keep in sync).
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.gstatic.com https://www.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://api.finoratech.info https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-src https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  # Safe to cache forever because the filename IS the content hash: Vite emits a new name whenever
  # the bytes change, so a cached copy can never be wrong -- it can only be unreferenced. Pages
  # defaults these to max-age=14400 with must-revalidate, which makes a returning visitor
  # revalidate every asset after four hours to be told, every time, that nothing changed.
  #
  # `immutable` is the half that matters most: without it a browser still revalidates on reload,
  # which is precisely when a user is most likely to be in a hurry.
  Cache-Control: public, max-age=31536000, immutable
