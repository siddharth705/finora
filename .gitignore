# ============================================================================================
# Finora - Repository Ignore Rules
#
# This repository intentionally ignores generated artifacts, secrets, local development state,
# temporary financial documents, AI datasets/models, and machine-specific configuration.
#
# Guiding Principle:
# Source control should contain only:
#   - Source code
#   - Documentation
#   - Tests
#   - Reproducible fixtures
#   - Configuration templates
#
# It should NEVER contain:
#   - Secrets
#   - Real customer financial documents
#   - Generated build artifacts
#   - Local IDE state
#   - AI datasets or model checkpoints
#   - Temporary debugging files
# ============================================================================================

# ============================================================================================
# Secrets
# ============================================================================================

# Bootstrap installation key (generated locally during first-time setup)
.finora/

# Environment files
.env
.env.*
*.env
*.env.local
*.env.development
*.env.production
*.env.test

# Keep only the template
!.env.example

# ============================================================================================
# Java / Maven / Gradle
# ============================================================================================

**/target/
*.class
*.jar
*.war
*.ear

# JVM crash logs
hs_err_pid*.log
replay_pid*.log

# Keep Maven wrapper
!.mvn/wrapper/maven-wrapper.jar

# ============================================================================================
# Node / Frontend
# ============================================================================================

**/node_modules/

**/dist/
**/dist-ssr/

.vite/
**/.vite/

# TypeScript incremental compilation cache
*.tsbuildinfo

# ============================================================================================
# Python (Future AI Services)
# ============================================================================================

__pycache__/
*.py[cod]
*.pyo

.venv/
venv/
env/

.pytest_cache/
.mypy_cache/

# ============================================================================================
# AI / ML (Future Financial Intelligence Engine)
# ============================================================================================

# Large models and datasets should never be committed
models/
datasets/
training/
checkpoints/
embeddings/
vector-db/
vector_store/

# Local AI experiments
.ai/
experiments/

# ============================================================================================
# Temporary Financial Documents
# ============================================================================================

# Real customer statements used for debugging.
# Never commit financial documents containing customer information.
backend/scratch-pdf/
scratch/
scratch-*/
tmp/
temp/

# Working directories people actually create, as opposed to the ones this file predicted. Added
# after a "Bank statement/" directory of real statements -- several named after the customer, one
# with an account number in the filename -- was found untracked and unignored at the repository
# root, which is one `git add -A` away from repeating
# docs/engineering/incidents/2026-08-03-customer-pii-in-git-history.md.
#
# Patterns rather than the one directory: the next person will pick a different name, and
# scripts/trace-capture.sh refuses a source path inside the repo precisely because this keeps
# happening. A statement belongs outside the working tree; this is the backstop for when it isn't.
[Bb]ank [Ss]tatement*/
[Ss]tatements/
*.pdf.local


# ============================================================================================
# Local Databases
# ============================================================================================

*.db
*.sqlite
*.sqlite3
*.mv.db

# ============================================================================================
# Docker
# ============================================================================================

docker-compose.override.yml

# ============================================================================================
